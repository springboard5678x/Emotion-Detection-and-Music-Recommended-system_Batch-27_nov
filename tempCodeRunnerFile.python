import queue
import time

# -------------------------------
# Romania Road Map (Graph)
# -------------------------------
graph = {
    'Arad': [('Zerind', 75), ('Timisoara', 118), ('Sibiu', 140)],
    'Zerind': [('Arad', 75), ('Oradea', 71)],
    'Oradea': [('Zerind', 71), ('Sibiu', 151)],
    'Sibiu': [('Arad', 140), ('Oradea', 151), ('Fagaras', 99), ('Rimnicu_Vilcea', 80)],
    'Timisoara': [('Arad', 118), ('Lugoj', 111)],
    'Lugoj': [('Timisoara', 111), ('Mehadia', 70)],
    'Mehadia': [('Lugoj', 70), ('Dobreta', 75)],
    'Dobreta': [('Mehadia', 75), ('Craiova', 120)],
    'Craiova': [('Dobreta', 120), ('Rimnicu_Vilcea', 146), ('Pitesti', 138)],
    'Rimnicu_Vilcea': [('Sibiu', 80), ('Craiova', 146), ('Pitesti', 97)],
    'Fagaras': [('Sibiu', 99), ('Bucharest', 211)],
    'Pitesti': [('Rimnicu_Vilcea', 97), ('Craiova', 138), ('Bucharest', 101)],
    'Bucharest': []
}

# -------------------------------
# h1: Euclidean (given SLD values)
# -------------------------------
h1 = {
    'Arad': 366, 'Bucharest': 0, 'Craiova': 160, 'Dobreta': 242,
    'Eforie': 161, 'Fagaras': 178, 'Giurgiu': 77, 'Hirsova': 151,
    'Iasi': 226, 'Lugoj': 244, 'Mehadia': 241, 'Neamt': 234,
    'Oradea': 380, 'Pitesti': 98, 'Rimnicu_Vilcea': 193,
    'Sibiu': 253, 'Timisoara': 329, 'Urziceni': 80,
    'Vaslui': 199, 'Zerind': 374
}

# -------------------------------
# Coordinates (for h2 Manhattan)
# -------------------------------
coordinates = {
    'Arad': (29,192), 'Bucharest': (268,55), 'Craiova': (163,22),
    'Dobreta': (91,32), 'Eforie': (420,28), 'Fagaras': (208,157),
    'Giurgiu': (264,8), 'Hirsova': (396,74), 'Iasi': (347,204),
    'Lugoj': (91,98), 'Mehadia': (93,65), 'Neamt': (290,229),
    'Oradea': (62,258), 'Pitesti': (220,88), 'Rimnicu_Vilcea': (147,124),
    'Sibiu': (126,164), 'Timisoara': (32,124), 'Urziceni': (333,74),
    'Vaslui': (376,153), 'Zerind': (44,225)
}

# -------------------------------
# h2: Manhattan heuristic
# -------------------------------
h2 = {
    city: abs(coordinates[city][0] - coordinates['Bucharest'][0]) +
          abs(coordinates[city][1] - coordinates['Bucharest'][1])
    for city in coordinates
}

# -------------------------------
# A* Tree Search (correct counting)
# -------------------------------
def Astar(start, heuristic, name, goal="Bucharest"):
    print(f"\n========== A* using {name} ==========")

    pq = queue.PriorityQueue()
    pq.put((heuristic[start], 0, start, [start]))

    nodes_explored = 1   # start node is generated
    step = 1
    start_time = time.time()

    while not pq.empty():
        f, g, current, path = pq.get()

        print(f"\nSTEP {step}")
        step += 1
        print(f"Expanding: {current}")
        print(f"g={g}, h={heuristic[current]}, f={f}")

        if current == goal:
            end_time = time.time()
            print("\n>>> GOAL REACHED")
            print("Final path:", path)
            print("Total cost:", g)
            print("Nodes explored (generated):", nodes_explored)
            print("Execution time:", end_time - start_time)
            return nodes_explored, end_time - start_time

        print("Possible options:")
        for neighbor, cost in graph[current]:
            g_new = g + cost
            h_new = heuristic[neighbor]
            f_new = g_new + h_new

            print(
                f"  {current} -> {neighbor} | "
                f"g={g_new}, h={h_new}, f={f_new}"
            )

            pq.put((f_new, g_new, neighbor, path + [neighbor]))
            nodes_explored += 1   # count every generated node

    return None

# -------------------------------
# Run A* for both heuristics
# -------------------------------
nodes_h1, time_h1 = Astar("Arad", h1, "Euclidean (h1)")
nodes_h2, time_h2 = Astar("Arad", h2, "Manhattan (h2)")

# -------------------------------
# Observation Table
# -------------------------------
print("\n========== OBSERVATION TABLE ==========")
print("Heuristic        Nodes Explored    Time Taken (s)")
print("-----------------------------------------------")
print(f"Euclidean (h1)    {nodes_h1:<16} {time_h1}")
print(f"Manhattan (h2)    {nodes_h2:<16} {time_h2}")
